# Sprag: create a key at https://sprag.ai/
SPRAG_API_KEY=your_sprag_api_key

# Vobiz: copy these from the overview page of https://console.vobiz.ai
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token

# A secret in the stream URL. Use a long random value; simulate_call.py reads it too.
STREAM_TOKEN=change-me-to-a-long-random-string

# Optional
# VOBIZ_CONTENT_TYPE=audio/x-mulaw;rate=8000   # or audio/x-l16;rate=16000
# SPRAG_VOICE=wade
# PORT=8765
